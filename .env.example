# --- Core ---
NODE_ENV=production
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/current_affairs
# At least 32 random characters: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Comma-separated origins allowed to call the API from a browser (admin panel is same-origin).
CORS_ORIGINS=
APP_TIMEZONE=Asia/Kolkata
# The mobile app compares itself to these to show "update available" / force update.
MIN_APP_VERSION=1.0.0
LATEST_APP_VERSION=1.0.0

# --- AI provider: claude | openai | gemini | mock ---
AI_PROVIDER=mock
# Leave empty to use the provider default (claude-opus-5-5, gpt-5-mini, gemini-2.5-flash).
AI_MODEL=
# Claude only: low | medium | high | xhigh | max
AI_EFFORT=high
AI_MAX_OUTPUT_TOKENS=16000
# Set the key for the provider you use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Pipeline ---
PIPELINE_BATCH_SIZE=10
PIPELINE_CONCURRENCY=2
PIPELINE_MAX_ATTEMPTS=3
PIPELINE_MAX_ITEM_AGE_HOURS=48
# Fetch the full article page for better source text (falls back to the feed summary).
PIPELINE_FETCH_FULL_TEXT=true
DAILY_QUIZ_SIZE=10
# Override the default feed list (JSON array of {id, publisher, url}).
FEEDS_JSON=
# Cron schedules, in APP_TIMEZONE.
CRON_INGEST=0 */2 * * *
CRON_GENERATE=20 */2 * * *
CRON_DAILY_QUIZ=0 7 * * *
# Hindi translation of approved articles (one AI call per article).
CRON_TRANSLATE=40 */2 * * *
TRANSLATE_BATCH_SIZE=5
# Weekly mock test (Sunday 08:00) and its Saturday reminder; evening daily-quiz reminder.
CRON_WEEKLY_MOCK=0 8 * * 0
CRON_MOCK_REMINDER=0 18 * * 6
CRON_DAILY_REMINDER=0 20 * * *
MOCK_SIZE=50

# --- Email (password reset codes) ---
# Any SMTP provider (Amazon SES, Resend, Brevo, Gmail Workspace, ...).
# Without it, codes are only logged in development; in production users won't receive them.
SMTP_URL=
MAIL_FROM=Unbound Daily <no-reply@zonty.in>

# --- Public URL of this server (for the premium checkout link), e.g. https://unbounddaily.zonty.in
PUBLIC_URL=

# --- Google / Apple sign-in ---
# Comma-separated Google OAuth client IDs whose ID tokens are accepted: the WEB client ID
# (the app asks Google for tokens issued to it), plus the iOS client ID later. See docs/GOOGLE.md.
GOOGLE_CLIENT_IDS=
# Apple: your iOS bundle ID (com.unbound.daily), plus a Services ID if you add Apple sign-in on the web.
APPLE_CLIENT_IDS=

# --- Premium ---
# Keep false until Razorpay is set up: while false, every feature is free for everyone.
PREMIUM_ENABLED=false
FREE_ARCHIVE_DAYS=30
FREE_BOOKMARKS=20
FREE_PRACTICE_PER_DAY=10
# Prices in paise (₹49 and ₹499).
PRICE_MONTHLY_PAISE=4900
PRICE_YEARLY_PAISE=49900
# Let the Android app open the web checkout. Google Play requires its own billing for digital
# subscriptions unless you're enrolled in its user choice billing programme; check before enabling.
# (The iOS app never shows a purchase button: App Store rules.)
PREMIUM_PURCHASE_ANDROID=false

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Created by `npm run razorpay:plans`.
RAZORPAY_PLAN_MONTHLY=
RAZORPAY_PLAN_YEARLY=

# --- Legal pages (/privacy, /terms, /refunds, /contact, /delete-account) ---
# Required before going live: the stores and Razorpay check these pages.
APP_NAME=Unbound Daily
# Play Store link for the website home page (after the first release).
STORE_URL=
LEGAL_OPERATOR=
LEGAL_CONTACT_EMAIL=
GRIEVANCE_OFFICER=
LEGAL_ADDRESS=
LEGAL_CITY=
LEGAL_EFFECTIVE_DATE=2026-11-18

# Evening digest of the day's new stories (IST). Default 18:30.
CRON_DAILY_DIGEST=30 18 * * *

# --- Auto-publish ---
# Default for the admin panel's Auto-publish switch: AI articles, their questions and
# Hindi translations go live without an editor. The switch in the admin panel overrides it.
AUTO_PUBLISH=true

# --- Push notifications (Expo) ---
PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=
