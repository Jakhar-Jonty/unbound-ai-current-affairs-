# --- Core ---
NODE_ENV=production
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/current_affairs
# At least 32 random characters: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Comma-separated origins allowed to call the API from a browser (admin panel is same-origin).
CORS_ORIGINS=
APP_TIMEZONE=Asia/Kolkata
# The mobile app compares itself to these to show "update available" / force update.
MIN_APP_VERSION=1.0.0
LATEST_APP_VERSION=1.0.0

# --- AI provider: claude | openai | gemini | mock ---
AI_PROVIDER=mock
# Leave empty to use the provider default (claude-opus-5-5, gpt-5-mini, gemini-2.5-flash).
AI_MODEL=
# Claude only: low | medium | high | xhigh | max
AI_EFFORT=high
AI_MAX_OUTPUT_TOKENS=16000
# Set the key for the provider you use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Pipeline ---
PIPELINE_BATCH_SIZE=10
PIPELINE_CONCURRENCY=2
PIPELINE_MAX_ATTEMPTS=3
PIPELINE_MAX_ITEM_AGE_HOURS=48
# Fetch the full article page for better source text (falls back to the feed summary).
PIPELINE_FETCH_FULL_TEXT=true
DAILY_QUIZ_SIZE=10
# Override the default feed list (JSON array of {id, publisher, url}).
FEEDS_JSON=
# Cron schedules, in APP_TIMEZONE.
CRON_INGEST=0 */2 * * *
CRON_GENERATE=20 */2 * * *
CRON_DAILY_QUIZ=0 7 * * *

# --- Email (password reset codes) ---
# Any SMTP provider (Amazon SES, Resend, Brevo, Gmail Workspace, ...).
# Without it, codes are only logged in development; in production users won't receive them.
SMTP_URL=
MAIL_FROM=Unbound <no-reply@yourdomain.com>

# --- Push notifications (Expo) ---
PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=
