{
  "expo": {
    "name": "Unbound Daily",
    "slug": "unbound-daily",
    "scheme": "unbounddaily",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F5F2EC",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.unbound.daily",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.unbound.daily",
      "adaptiveIcon": {
        "backgroundColor": "#F5F2EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#FF7928"
        }
      ],
      "expo-apple-authentication",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "apiUrl": "https://unbounddaily.zonty.in",
      "storeUrl": {
        "ios": "",
        "android": ""
      },
      "googleClientIds": {
        "web": "",
        "ios": ""
      },
      "legal": {
        "privacy": "https://unbounddaily.zonty.in/privacy",
        "terms": "https://unbounddaily.zonty.in/terms",
        "deleteAccount": "https://unbounddaily.zonty.in/delete-account"
      }
    }
  }
}
