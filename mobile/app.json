{
  "expo": {
    "name": "Unbound Daily",
    "slug": "unbound-daily",
    "scheme": "unbounddaily",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F5F2EC",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.unbound.daily",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.unbound.daily",
      "adaptiveIcon": {
        "backgroundColor": "#151515",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#FF7928",
          "icon": "./assets/notification-icon.png"
        }
      ],
      "expo-apple-authentication",
      "@react-native-google-signin/google-signin",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F5F2EC",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#151515"
          }
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://unbounddaily.zonty.in",
      "storeUrl": {
        "ios": "",
        "android": ""
      },
      "googleClientIds": {
        "web": "469270210500-l4ll75ufpghj2k6iqi319u1347m42gop.apps.googleusercontent.com",
        "ios": ""
      },
      "legal": {
        "privacy": "https://unbounddaily.zonty.in/privacy",
        "terms": "https://unbounddaily.zonty.in/terms",
        "deleteAccount": "https://unbounddaily.zonty.in/delete-account"
      },
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "64526204-e6ba-4b2a-955f-9f56ef15d332"
      }
    },
    "owner": "jonty007"
  }
}
