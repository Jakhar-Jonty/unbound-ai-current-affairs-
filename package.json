{
  "name": "unbound-ai-current-affairs",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted current affairs platform for UPSC aspirants: verified content library, daily quizzes, bookmarks, admin review and an automated content pipeline.",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "worker": "node src/worker.js",
