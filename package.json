    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "fast-xml-parser": "^5.12.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.17",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.6.0",
    "openai": "^7.57.0",
    "pino": "^10.4.0",
    "razorpay": "^2.9.8",
    "zod": "^4.6.7"
